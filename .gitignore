# BuildSync AI · .gitignore
#
# Author:    Giordano Bertin-Maurice
# Copyright: © 2026 Giordano Bertin-Maurice. All rights reserved.
#
# WHAT IT DOES
#   Lists files and folders Git must NOT track (version-control).
#
# WHAT IT IS FOR
#   Keeps generated and machine-specific files out of the repository so only
#   source code is committed.

# Installed packages. Recreate with `npm install`.
node_modules

# Next.js build output and dev cache. Recreate with `npm run build` / `npm run dev`.
.next

# Static-export output folder (only exists if the site is ever exported).
out

# Auto-generated by Next.js (types for Next); changes on every run.
next-env.d.ts

# TypeScript incremental-check cache.
*.tsbuildinfo

# macOS folder metadata.
.DS_Store
.gstack/
